{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!data/scraped", "!**/*.svg", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "yaml": {
    "formatter": {
      "quoteStyle": "single",
      "bracketSpacing": false,
      "lineWidth": 320
    }
  }
}
